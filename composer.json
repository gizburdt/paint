{
    "name": "gizburdt/paint",
    "description": "Manipulate, transform and present data with ease",
    "keywords": ["laravel", "presenter"],
    "homepage": "https://github.com/gizburdt/paint",
    "license": "MIT",
    "authors": [
        {
            "name": "Gijs Jorissen",
            "homepage": "https://gijsjorissen.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gizburdt\\Paint\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gizburdt\\Paint\\Test\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
